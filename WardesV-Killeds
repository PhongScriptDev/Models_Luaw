local sound = Instance.new("Sound")
sound.Name = "CustomAudio"
sound.Volume = 0.5
sound.Looped = true
sound.Parent = SoundService

local isPlaying = false
local hasLoaded = false
local toggleAnim

local function updateToggleUI(on)
    if toggleAnim then toggleAnim:Cancel() end
    local targetPos = on and UDim2.new(1, -27, 0.5, -12) or UDim2.new(0, 3, 0.5, -12)
    local targetColor = on and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(80, 80, 80)
    
    toggleAnim = TweenService:Create(toggleKnob, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {Position = targetPos})
    toggleAnim:Play()
    TweenService:Create(toggleBg, TweenInfo.new(0.2), {BackgroundColor3 = targetColor}):Play()
    
    statusLabel.Text = on and "🔊 Đang phát" or "🔇 Đang tắt"
    statusLabel.TextColor3 = on and Color3.fromRGB(0, 255, 150) or Color3.fromRGB(200, 200, 200)
end

-- Xử lý Tải Nhạc
loadBtn.MouseButton1Click:Connect(function()
    local url = inputBox.Text:gsub("%s+", "")
    if url == "" then return end
    
    sound:Stop()
    isPlaying = false
    updateToggleUI(false)
    
    statusLabel.Text = "⏳ Đang tải..."
    statusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
    
    local success, err = pcall(function()
        local tempPath = "audio_temp.mp3"
        local body = game:HttpGet(url)
        
        if not body or #body < 1000 then
            error("File rỗng hoặc bị chặn!")
        end
        
        writefile(tempPath, body)
        local assetId = getcustomasset(tempPath)
        sound.SoundId = assetId
    end)
    
    if success then
        hasLoaded = true
        statusLabel.Text = "✅ Đã tải, bật toggle!"
        statusLabel.TextColor3 = Color3.fromRGB(0, 255, 150)
    else
        warn("Lỗi:", err)
        statusLabel.Text = "❌ Lỗi tải link!"
        statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
    end
end)

-- Xử lý Toggle
toggleBtn.MouseButton1Click:Connect(function()
    if not hasLoaded then
        statusLabel.Text = "⚠️ Chưa có nhạc!"
        statusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
        return
    end
    
    isPlaying = not isPlaying
    updateToggleUI(isPlaying)
    
    if isPlaying then
        sound:Play()
    else
        sound:Stop()
    end
end)

-- Xử lý Lưu Script (Tạo thư mục Mana & file script.txt)
saveScriptBtn.MouseButton1Click:Connect(function()
    local rawText = scriptInput.Text
    if rawText == "" then return end
    
    -- Kiểm tra và tạo thư mục "Mana"
    if not isfolder("Mana") then
        makefolder("Mana")
    end
    
    -- Đường dẫn file
    local filePath = "Mana/script.txt"
    
    -- Tự động trích xuất link trong game:HttpGet(...)
    local extractedLink = "Không tìm thấy link"
    local foundLink = rawText:match('game:HttpGet%("([^"]+)"%)')
    if foundLink then
        extractedLink = foundLink
    end
    
    -- Ghi toàn bộ nội dung vào file script.txt
    local success, err = pcall(function()
        writefile(filePath, rawText)
    end)
    
    if success then
        saveScriptBtn.Text = "✅ Đã lưu thành công!"
        saveScriptBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 50)
        print("[Mana] Đã lưu code vào " .. filePath)
        print("[Mana] Link trích xuất được: " .. extractedLink)
        
        task.wait(2)
        saveScriptBtn.Text = "💾 Lưu Code"
        saveScriptBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
        scriptInput.Text = ""
    else
        saveScriptBtn.Text = "❌ Lỗi khi lưu!"
        saveScriptBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        warn("Lỗi lưu file:", err)
        
        task.wait(2)
        saveScriptBtn.Text = "💾 Lưu Code"
        saveScriptBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
    end
end)

updateToggleUI(false)
