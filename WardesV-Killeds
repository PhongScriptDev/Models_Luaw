-- ============================================
-- TỰ ĐỘNG BẮT LINK & PHÁT NHẠC (AUTO)
-- Không GUI, không nút, tự chạy 100%
-- ============================================

local SoundService = game:GetService("SoundService")

-- 1. Tự động lấy nội dung của đoạn code mày vừa Execute
local rawCode = debug.getinfo(1, "s").source
local executedLink = ""

if rawCode then
    rawCode = rawCode:gsub("^@", "") -- Làm sạch chuỗi
    
    -- 2. Tự động tìm link nằm trong game:HttpGet("...")
    local foundLink = rawCode:match('game:HttpGet%("([^"]+)"%)')
    
    if foundLink then
        executedLink = foundLink
        print("[Mana] Đã tự động bắt được link: " .. executedLink)
        
        -- 3. Tự động tạo thư mục Mana và lưu link vào script.txt
        if not isfolder("Mana") then
            makefolder("Mana")
        end
        
        writefile("Mana/script.txt", executedLink)
        print("[Mana] Đã lưu link vào Mana/script.txt")
    else
        warn("[Mana] Không tìm thấy link game:HttpGet trong script vừa Execute!")
    end
end

-- 4. Tự động tải và phát nhạc nếu link bắt được là file .mp3
if executedLink ~= "" and executedLink:match("%.mp3") then
    print("[Mana] Phát hiện link MP3, đang tải và phát nhạc...")
    
    local success, err = pcall(function()
        local tempPath = "Mana/audio_temp.mp3"
        local body = game:HttpGet(executedLink) -- Tải nhạc từ link
        
        if body and #body > 1000 then
            writefile(tempPath, body)
            local assetId = getcustomasset(tempPath)
            
            -- Tạo Sound và tự động phát
            local sound = Instance.new("Sound")
            sound.Name = "ManaAutoAudio"
            sound.SoundId = assetId
            sound.Volume = 0.5
            sound.Looped = true
            sound.Parent = SoundService
            
            sound:Play()
            print("[Mana] Đang phát nhạc tự động!")
        end
    end)
    
    if not success then
        warn("[Mana] Lỗi tải nhạc: ", err)
    end
elseif executedLink ~= "" then
    print("[Mana] Link đã lưu nhưng không phải file .mp3 nên không phát nhạc.")
end
