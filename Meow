-- Kéo thả GUI
local dragging, dragInput, dragStart, startPos
TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
TopBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- ================== LOGIC QUÉT NEXTBOT & TELEPORT ==================
local isTeleporting = false
local teleportConnection = nil

-- Hàm quét toàn bộ Nextbot hiện có trên map
local function GetAllNextBots()
    local bots = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:GetAttribute("Team") == "Nextbot" then
            local root = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("UpperTorso") or obj:FindFirstChild("Torso") or obj.PrimaryPart
            if root then
                table.insert(bots, root)
            end
        end
    end
    return bots
end

-- Bật / Tắt
ToggleBtn.MouseButton1Click:Connect(function()
    isTeleporting = not isTeleporting
    
    if isTeleporting then
        ToggleBtn.Text = "Auto Teleport to All Next-Bots: ON"
        ToggleBtn.BackgroundColor3 = Theme.Accent
        BtnStroke.Color = Color3.fromRGB(255, 150, 150)
        TweenService:Create(ToggleBtn, TweenInfo.new(0.2), {TextColor3 = Color3.new(1,1,1)}):Play()

        -- Bắt đầu vòng lặp teleport
        teleportConnection = RunService.Heartbeat:Connect(function()
            if not isTeleporting then return end
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            
            if hrp and hum and hum.Health > 0 then
                local bots = GetAllNextBots()
                if #bots > 0 then
                    -- Lấy con bot đầu tiên trong danh sách quét được và teleport tới đó
                    local targetBot = bots[1]
                    pcall(function()
                        hrp.CFrame = CFrame.new(targetBot.Position + Vector3.new(0, 3, 0))
                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    end)
                end
            end
        end)
    else
        ToggleBtn.Text = "Auto Teleport to All Next-Bots: OFF"
        ToggleBtn.BackgroundColor3 = Theme.Panel
        BtnStroke.Color = Theme.SubText
        TweenService:Create(ToggleBtn, TweenInfo.new(0.2), {TextColor3 = Theme.Text}):Play()

        -- Dừng vòng lặp
        if teleportConnection then
            teleportConnection:Disconnect()
            teleportConnection = nil
        end
    end
end)

-- Dọn dẹp khi nhân vật chết / respawn
LocalPlayer.CharacterAdded:Connect(function()
    if isTeleporting then
        isTeleporting = false
        ToggleBtn.Text = "Auto Teleport to All Next-Bots: OFF"
        ToggleBtn.BackgroundColor3 = Theme.Panel
        BtnStroke.Color = Theme.SubText
        TweenService:Create(ToggleBtn, TweenInfo.new(0.2), {TextColor3 = Theme.Text}):Play()
        if teleportConnection then
            teleportConnection:Disconnect()
            teleportConnection = nil
        end
    end
end)
