-- ===== ANTI-STUN/SLOW/KNOCKBACK =====
spawn(function()
    while true do
        wait(0.1)
        pcall(function()
            if player.Character then
                local humanoid = player.Character:FindFirstChild("Humanoid")
                local rootPart = player.Character:FindFirstChild("HumanoidRootPart")
                
                if humanoid and rootPart then
                    if humanoid.Sit then humanoid.Sit = false end
                    if humanoid.WalkSpeed < 16 then humanoid.WalkSpeed = 16 end
                    if rootPart.Anchored then rootPart.Anchored = false end
                    
                    -- Chống knockback
                    local velocity = rootPart.Velocity
                    if Vector3.new(velocity.X, 0, velocity.Z).Magnitude > 50 then
                        rootPart.Velocity = Vector3.new(0, velocity.Y, 0)
                    end
                end
            end
        end)
    end
end)

