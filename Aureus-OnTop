-- ===== HÀM GIẾT NGƯỜI CHƠI KHÔNG CẦN TOOL =====
local function killPlayer(targetPlayer)
    pcall(function()
        local targetCharacter = targetPlayer.Character
        if not targetCharacter then return end
        
        local targetHumanoid = targetCharacter:FindFirstChild("Humanoid")
        if not targetHumanoid or targetHumanoid.Health <= 0 then return end
        
        local targetRootPart = targetCharacter:FindFirstChild("HumanoidRootPart")
        
        -- Cách 1: Set Health trực tiếp
        targetHumanoid.Health = 0
        
        -- Cách 2: TakeDamage cực lớn
        targetHumanoid:TakeDamage(99999999)
        
        -- Cách 3: Break Joints
        if targetRootPart then
            targetRootPart:BreakJoints()
        end
        
        -- Cách 4: Destroy Character
        if targetCharacter.Parent then
            targetCharacter:Destroy()
        end
        
        -- Cách 5: Set Parent nil
        if targetCharacter.Parent then
            targetCharacter.Parent = nil
        end
        
        -- Cách 6: Xóa tất cả body parts
        for _, part in pairs(targetCharacter:GetChildren()) do
            if part:IsA("BasePart") or part:IsA("Part") then
                part:Destroy()
            end
        end
    end)
end

