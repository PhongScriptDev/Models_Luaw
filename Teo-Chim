                end

                local camera = workspace.CurrentCamera
                local camPos = camera.CFrame.Position
                local lookDirection = (TARGET_XYZ - camPos).Unit
                camera.CFrame = CFrame.lookAt(camPos, camPos + lookDirection)
                isCameraForced = true
                
                task.spawn(function()
                    task.wait(0.15)
