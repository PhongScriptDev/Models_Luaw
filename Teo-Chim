local function getAllItems()
    local items, player = {}, game.Players.LocalPlayer
    if not player then return items end
    local pc = player.Character
    local evtNames, spcNames = GetValidEventItemNames(), GetValidSpecialItemNames()
    if #evtNames == 0 and #spcNames == 0 then return items end
    
    local desc = workspace:GetDescendants()
    for i = 1, #desc do
        local v = desc[i]
        if (v:IsA("BasePart") or v:IsA("Model")) and not (pc and v:IsDescendantOf(pc)) then
            local name = string.lower(v.Name)
            local matchedName, isSpecial = nil, false
            
            for _, itemName in ipairs(evtNames) do
                if string.find(name, string.lower(itemName)) then matchedName = itemName; isSpecial = false; break end
            end
            if not matchedName then
                for _, itemName in ipairs(spcNames) do
                    if string.find(name, string.lower(itemName)) then matchedName = itemName; isSpecial = true; break end
                end
            end
            
            if matchedName then
                local part = v:IsA("BasePart") and v or v:FindFirstChildWhichIsA("BasePart")
                if part and part.Parent then 
                    table.insert(items, { Object = part, Name = matchedName, RawName = v.Name, Position = part.Position, IsSpecial = isSpecial }) 
                end
            end
        end
    end
    return items
end

