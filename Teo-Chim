local function muteGameSounds(exceptSound)
    if gameMuted then return end
    gameSoundsBackup = {}
    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("Sound") and obj ~= exceptSound then
            if obj.Parent and obj.Parent ~= workspace then
                table.insert(gameSoundsBackup, { sound = obj, volume = obj.Volume })
                obj.Volume = 0
            end
        end
    end
    gameMuted = true
end

local function restoreGameSounds()
    if not gameMuted then return end
    for _, entry in ipairs(gameSoundsBackup) do
        if entry.sound and entry.sound.Parent then pcall(function() entry.sound.Volume = entry.volume end) end
    end
    gameSoundsBackup = {}
    gameMuted = false
end

