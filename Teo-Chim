-- ===== ANTI-AFK SYSTEM ======================================
-- ============================================================
local antiAfkEnabled = false
local lastUserActionTime = tick()
local antiAfkDelayThreshold = 30
local antiAfkLoopRunning = false
local isSimulatingInput = false

local function GetActualAfkTime() return tick() - lastUserActionTime end

local function SimulateKeyPress(keyCode)
    pcall(function()
        isSimulatingInput = true
        local VIM = game:GetService("VirtualInputManager")
        VIM:SendKeyEvent(true, keyCode, false, game)
        task.wait(0.1)
        VIM:SendKeyEvent(false, keyCode, false, game)
        task.wait(0.2)
        isSimulatingInput = false
    end)
end

local function DoAntiAfkAction()
    local action = math.random(1, 3)
    if action == 1 then
        SimulateKeyPress(Enum.KeyCode.Tab); task.wait(0.5); SimulateKeyPress(Enum.KeyCode.Tab)
    elseif action == 2 then
        SimulateKeyPress(Enum.KeyCode.W); task.wait(0.2)
    elseif action == 3 then
        SimulateKeyPress(math.random(1, 2) == 1 and Enum.KeyCode.C or Enum.KeyCode.F)
    end
end

local function StartAntiAfkLoop()
    if antiAfkLoopRunning or not antiAfkEnabled then return end
    antiAfkLoopRunning = true
    WindUI:Notify({ Title = "📊 Anti AFK", Content = "✔️ Đã kích hoạt", Duration = 5 })
    task.spawn(function()
        while antiAfkEnabled and GetActualAfkTime() >= antiAfkDelayThreshold do
            task.wait(math.random(1, 10))
            if not antiAfkEnabled or GetActualAfkTime() < antiAfkDelayThreshold then break end
            DoAntiAfkAction()
        end
        antiAfkLoopRunning = false
    end)
end

task.spawn(function()
    while task.wait(1) do
        if antiAfkEnabled and GetActualAfkTime() >= antiAfkDelayThreshold and not antiAfkLoopRunning then StartAntiAfkLoop() end
    end
end)

