local function formatTime(sec) sec = math.floor(sec or 0); return string.format("%02d:%02d", math.floor(sec / 60), sec % 60) end
local function formatDate(isoString)
    if not isoString or isoString == "" then return "—" end
    local y, m, d = string.match(isoString, "^(%d+)-(%d+)-(%d+)")
    if y and m and d then return string.format("%s/%s/%s", d, m, y) end
    return "—"
end

local function estimateSize(durationSec)
    local bytes = durationSec * 16 * 1024
    if bytes >= 1024 * 1024 then return string.format("%.2f MB", bytes / (1024 * 1024))
    elseif bytes >= 1024 then return string.format("%.2f KB", bytes / 1024) end
    return bytes .. " B"
end

local function checkSound(assetId, waitSeconds)
    waitSeconds = waitSeconds or 7
    local tempSound = Instance.new("Sound")
    tempSound.SoundId = assetId
    tempSound.Volume = 0
    tempSound.Parent = workspace
    local waited = 0
    while waited < waitSeconds do task.wait(0.1); waited = waited + 0.1 end
    local ok = tempSound.IsLoaded and tempSound.TimeLength > 0
    local reason = ""
    if not ok then
        if not tempSound.IsLoaded then reason = "Không load được sound (asset có thể bị private, không tồn tại, hoặc sai định dạng)"
        elseif tempSound.TimeLength <= 0 then reason = "Sound không có thời lượng (file bị hỏng hoặc định dạng không được Roblox hỗ trợ)"
        else reason = "Không xác định được lỗi" end
    end
    local timeLength = tempSound.TimeLength
    tempSound:Destroy()
    return ok, reason, timeLength
end

local function checkLocalFile(path, waitSeconds)
    waitSeconds = waitSeconds or 7
    local ok, assetId = pcall(getcustomasset, path)
    if not ok then return false, "Không tạo được asset từ file (file không tồn tại hoặc client không hỗ trợ)", 0 end
    return checkSound(assetId, waitSeconds)
end

local function startFileInfoLoop(sound, filename)
    local nameOnly, ext = string.match(filename, "^(.-)(%.%w+)$")
    nameOnly = nameOnly or filename
    ext = ext or ""
    task.spawn(function()
        local waited = 0
        while sound.TimeLength <= 0 and waited < 3 do task.wait(0.1); waited = waited + 0.1 end
        while sound and sound.Parent do
            local cur, total = sound.TimePosition or 0, sound.TimeLength or 0
            pcall(function()
                FileInfo:SetDesc("File name: " .. nameOnly .. " | " .. ext .. "\nTime of music: " .. formatTime(cur) .. " - " .. formatTime(total) .. "\nMemory of music: " .. (total > 0 and estimateSize(total) or "—"))
            end)
            task.wait(0.5)
        end
    end)
end

local function isSupported(filename)
    local lower = string.lower(filename)
    for _, ext in ipairs(SUPPORTED_EXTS) do if string.sub(lower, -#ext) == ext then return true end end
    return false
end

local function refreshMusicList()
    musicList, musicPathMap = {}, {}
    local ok, files = pcall(listfiles, "")
    if ok and files then
        for _, filePath in ipairs(files) do
            local filename = string.match(filePath, "([^/\\]+)$") or filePath
            if isSupported(filename) then table.insert(musicList, filename); musicPathMap[filename] = filePath end
        end
    end
    if #musicList == 0 then table.insert(musicList, "Không tìm thấy tệp nhạc") end
    return musicList
end

local function stopCurrent()
    if currentSound then pcall(function() currentSound:Stop() end); pcall(function() currentSound:Destroy() end); currentSound = nil end
    restoreGameSounds()
end

local function playSelected()
    if not selectedTrack or selectedTrack == "Không tìm thấy tệp nhạc" then return end
    local path = musicPathMap[selectedTrack]
    if not path then return end
    local ok, assetId = pcall(getcustomasset, path)
    if not ok then WindUI:Notify({ Title = "❌ Checkout Sound", Content = "Không tải được file: " .. selectedTrack, Duration = 3 }); return end
    stopCurrent()
    local sound = Instance.new("Sound")
    sound.SoundId, sound.Volume, sound.Looped, sound.Parent = assetId, 0.5, false, workspace
    currentSound = sound
    muteGameSounds(sound); sound:Play(); startFileInfoLoop(sound, selectedTrack)
    sound.Ended:Connect(function()
        if autoPlayEnabled and currentSound == sound then task.wait(0.3); if autoPlayEnabled then sound:Play() end
        else restoreGameSounds() end
    end)
    sound:GetPropertyChangedSignal("Playing"):Connect(function()
        if autoPlayEnabled and currentSound == sound and not sound.Playing then
            task.wait(1)
            if autoPlayEnabled and currentSound == sound and not sound.Playing then pcall(function() sound:Play() end) end
        elseif not autoPlayEnabled and currentSound == sound and not sound.Playing then restoreGameSounds() end
    end)
end

local checkingFile = false
local function updateFileInfo(filename, path)
    if not filename then FileInfo:SetDesc("File name: — | —\nTime of music: 00:00 - 00:00\nMemory of music: —"); return end
    local nameOnly, ext = string.match(filename, "^(.-)(%.%w+)$")
    nameOnly, ext = nameOnly or filename, ext or ""
    local totalTime = 0
    if path then
        local ok, assetId = pcall(getcustomasset, path)
        if ok then
            local tempSound = Instance.new("Sound")
            tempSound.SoundId = assetId; tempSound.Parent = workspace
            local waited = 0
            while tempSound.TimeLength <= 0 and waited < 3 do task.wait(0.1); waited = waited + 0.1 end
            totalTime = tempSound.TimeLength or 0
            tempSound:Destroy()
        end
    end
    FileInfo:SetDesc("File name: " .. nameOnly .. " | " .. ext .. "\nTime of music: " .. formatTime(0) .. " - " .. formatTime(totalTime) .. "\nMemory of music: " .. (totalTime > 0 and estimateSize(totalTime) or "—"))
end

local function onSelectMusic(option)
    if checkingFile then return end
    if not option or option == "Không tìm thấy tệp nhạc" then selectedTrack = nil; updateFileInfo(nil); return end
    checkingFile, selectedTrack = true, option
    local path = musicPathMap[option]
    WindUI:Notify({ Title = "🔎 Checking & filtering music", Content = "Đang tải và kiểm tra " .. option .. "...", Duration = 3 })
    task.spawn(function()
        local ok, reason, timeLength = checkLocalFile(path, 7)
