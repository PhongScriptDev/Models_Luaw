local AudioInfo = MusicTab:Paragraph({ Title = "🎶 Audio roblox", Desc = "Audio creator: —\nAudio name: —\nTarget asset ID: —\nDate created: —\nAudio length: 00:00 - 00:00", Color = "Orange" })

local function startAudioInfoLoop(sound)
    task.spawn(function()
        local waited = 0
        while sound.TimeLength <= 0 and waited < 3 do task.wait(0.1); waited = waited + 0.1 end
        local creatorName, audioName, dateCreated = "—", "—", "—"
        local okInfo, info = pcall(function() return game:GetService("MarketplaceService"):GetProductInfoAsync(tonumber(currentAudioId), Enum.InfoType.Asset) end)
        if okInfo and info then
            if info.Creator then creatorName = info.Creator.Name or "—" end
            if info.Name then audioName = info.Name end
            if info.Created then dateCreated = formatDate(info.Created) end
        end
        while sound and sound.Parent do
            pcall(function() AudioInfo:SetDesc("Audio creator: " .. creatorName .. "\nAudio name: " .. audioName .. "\nTarget asset ID: " .. tostring(currentAudioId) .. "\nDate created: " .. dateCreated .. "\nAudio length: " .. formatTime(sound.TimePosition) .. " - " .. formatTime(sound.TimeLength)) end)
            task.wait(0.5)
        end
    end)
end

local function stopAudio()
    if currentAudio then pcall(function() currentAudio:Stop() end); pcall(function() currentAudio:Destroy() end); currentAudio = nil end
    restoreGameSounds()
end

local function playAudioById()
    if not currentAudioId or currentAudioId == "" then WindUI:Notify({ Title = "❌ Checkout Sound", Content = "Chưa nhập ID sound!", Duration = 3 }); return end
    stopAudio()
    local sound = Instance.new("Sound")
    sound.SoundId, sound.Volume, sound.Looped, sound.Parent = "rbxassetid://" .. tostring(currentAudioId), 0.5, false, workspace
    currentAudio = sound
    muteGameSounds(sound)
    local ok, err = pcall(function() sound:Play() end)
    if not ok then WindUI:Notify({ Title = "❌ Checkout Sound", Content = "ID không hợp lệ hoặc bị private.", Duration = 3 }); restoreGameSounds(); return end
    startAudioInfoLoop(sound)
    sound.Ended:Connect(function() if autoAudioEnabled and currentAudio == sound then task.wait(0.3); if autoAudioEnabled then pcall(function() sound:Play() end) end else restoreGameSounds() end end)
    sound:GetPropertyChangedSignal("Playing"):Connect(function()
        if autoAudioEnabled and currentAudio == sound and not sound.Playing then
            task.wait(1)
            if autoAudioEnabled and currentAudio == sound and not sound.Playing then pcall(function() sound:Play() end) end
        elseif not autoAudioEnabled and currentAudio == sound and not sound.Playing then restoreGameSounds() end
    end)
end

